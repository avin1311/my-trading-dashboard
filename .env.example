# OI Data Source Configuration
# Options: nse (default, free), zerodha, upstox, mock

# Default: NSE direct (free, no auth needed, may 403 from some servers)
OI_DATA_SOURCE=nse

# --- Zerodha Kite (paid, requires demat account) ---
# Get API key from https://kite.zerodha.com/connect
# Access token is obtained via TOTP login (valid for 1 day)
# ZERODHA_API_KEY=your_api_key
# ZERODHA_ACCESS_TOKEN=your_access_token

# --- Upstox (paid, requires demat account) ---
# Get API key from https://upstox.com/developer/api
# Access token via OAuth flow
# UPSTOX_API_KEY=your_api_key
# UPSTOX_ACCESS_TOKEN=your_access_token