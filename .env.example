# ==================== DATABASE ====================
DATABASE_URL=file:./db/custom.db

# ==================== OI Data Source ====================
# Options: nse (default, free), zerodha, upstox, mock
OI_DATA_SOURCE=nse

# ==================== Upstox Integration (for live prices via WebSocket) ====================
# Required for real-time data. Get these from https://upstox.com/developer/api
#
# 1. Create an app at Upstox Developer Portal
# 2. Set Redirect URL to: http://localhost:3000/api/upstox/callback
# 3. Copy API Key and API Secret here
#
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Only change if deploying to a non-localhost URL (e.g. https://yourdomain.com)
# UPSTOX_REDIRECT_URI=http://localhost:3000/api/upstox/callback

# ==================== Zerodha Kite (alternative to Upstox) ====================
# Get API key from https://kite.zerodha.com/connect
# ZERODHA_API_KEY=your_api_key
# ZERODHA_ACCESS_TOKEN=your_access_token
